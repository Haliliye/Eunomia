# Copy this file to .env (same folder as docker-compose.yml) and fill in a
# real value before running `docker compose up`. Never commit the real .env.
#
# Generate a random 32+ character value, e.g.:
#   openssl rand -base64 32
JWT_SECRET_KEY=

# --- Optional: real email sending ---------------------------------------
# Leave all of these blank and email verification / password reset still
# work — the API just returns the link directly in the response instead of
# emailing it (see README's Auth section). Fill these in with any standard
# SMTP provider (SendGrid, Mailgun, Amazon SES's SMTP interface, Gmail's SMTP
# relay, etc.) to send real emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Eunomia

# --- Optional: Cloudflare R2 for attachment storage ----------------------
# Leave all of these blank (or R2_ENABLED=false) and attachments are stored
# on local disk instead — fine for local dev, but that disk doesn't survive
# a container being recreated (e.g. most free hosting tiers). Fill these in
# with a bucket + API token from the Cloudflare R2 dashboard to persist
# attachments properly. See README's "Attachment storage" section.
R2_ENABLED=false
R2_SERVICE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
